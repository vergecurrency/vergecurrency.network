{
  "name": "verge-dashboard",
  "version": "1.3.0",
  "private": true,
  "description": "Verge mining hashrate and difficulty with a public retrowave dashboard",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:general": "node src/general/index.js",
    "start:web": "node --env-file-if-exists=.env src/web/server.js",
    "preview:web": "node src/web/server.js --demo",
    "check": "node src/index.js --check",
    "collect:once": "node src/index.js --once",
    "backfill": "node --env-file-if-exists=.env src/backfill.js",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vergecurrency/vergecurrency.network.git"
  },
  "author": "marplezdev <kk@kk.com>",
  "license": "MIT"
}
