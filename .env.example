# Export variables in your shell, or load this file with Node:
# node --env-file=.env src/index.js
# Environment variables override the existing credentials.json file.
# Keep credentials.json and .env private (chmod 600), outside any web root.
VERGE_RPC_URL=http://127.0.0.1:20102
# VERGE_RPC_USER=your-verge-rpc-user
# VERGE_RPC_PASSWORD=your-verge-rpc-password
# VERGE_RPC_COOKIE_FILE=/path/to/daemon/.cookie
# VERGE_CREDENTIALS_FILE=/opt/vergecurrency.network/credentials.json
INFLUX_URL=http://127.0.0.1:8086
# INFLUX_USERNAME=your-influx-user
# INFLUX_PASSWORD=your-influx-password
# Optional separate READ-only InfluxDB account for the public chart server:
# INFLUX_READ_USERNAME=your-read-only-influx-user
# INFLUX_READ_PASSWORD=your-read-only-influx-password
# The public UI stays on loopback; Nginx handles public HTTPS access.
WEB_HOST=127.0.0.1
WEB_PORT=3001
COLLECT_INTERVAL_MS=60000
RPC_TIMEOUT_MS=15000
INFLUX_TIMEOUT_MS=15000
