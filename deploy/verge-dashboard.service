[Unit]
Description=Verge algorithm hashrate and difficulty collector
Wants=network-online.target
After=network-online.target influxdb.service

[Service]
Type=simple
User=username
Group=username
WorkingDirectory=/opt/vergecurrency.network
Environment=NODE_ENV=production
EnvironmentFile=-/opt/vergecurrency.network/.env
ExecStart=/usr/bin/node /opt/vergecurrency.network/src/index.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=150
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
